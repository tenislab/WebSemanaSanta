+  const offset = (primero.getDay() + 6) % 7
+  const dias = new Date(anio, mes + 1, 0).getDate()
+  const celdas: (number | null)[] = Array(offset).fill(null)
+  for (let d = 1; d <= dias; d++) celdas.push(d)
+  return celdas
