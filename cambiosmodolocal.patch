+/* Un dato colocado sobre la papeleta. El punto de anclaje (left/top) es el
+   centro vertical; la alineación horizontal decide de qué lado crece. */
+.modelo-campo {
+  position: absolute;
+  white-space: nowrap;
+  transform: translateY(-50%);
+  font-family: Georgia, 'Times New Roman', serif;
+}
+.modelo-campo--center { transform: translate(-50%, -50%); }
+.modelo-campo--right { transform: translate(-100%, -50%); }
+
+/* Editor: cada dato es arrastrable y seleccionable. */
+.modelo-editor__lienzo { touch-action: none; cursor: default; margin: 0.6rem 0; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
+.modelo-editor__campo {
+  cursor: grab;
+  outline: 1px dashed rgba(120, 120, 120, 0.5);
+  outline-offset: 2px;
+  padding: 0 1px;
+}
+.modelo-editor__campo--sel {
+  outline: 2px solid var(--accent, #c5a059);
+  background: rgba(197, 160, 89, 0.14);
+}
+.modelo-editor__barra { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.4rem; }
+.modelo-editor__panel {
+  border: 1px solid var(--border);
+  border-radius: 10px;
+  padding: 0.9rem 1rem;
+  margin-top: 0.6rem;
+  background: var(--surface-2, rgba(0, 0, 0, 0.02));
+  display: flex;
+  flex-direction: column;
+  gap: 0.6rem;
+}
+.modelo-editor__subir { text-align: center; padding: 1.4rem 0; }
+.modelo-editor__subir .btn { display: inline-flex; }
+
+@media print {
+  .modelo-render__lienzo, .modelo-editor__lienzo { border: none; }
+}
+
